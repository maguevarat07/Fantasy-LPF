# Desarrollo local. Vercel administra el puerto y no usa DATABASE_PATH.
PORT=3001
DATABASE_PATH=./data/fantasy-lpf.sqlite

# Producción en Supabase. DATABASE_URL debe usar el pool transaccional; DIRECT_URL se reserva
# para migraciones administrativas y no debe usarse para las peticiones normales de la API.
DATABASE_URL=
DIRECT_URL=

# Vercel añade `Authorization: Bearer <CRON_SECRET>` a la llamada programada. Usa un valor
# aleatorio largo y configúralo únicamente como secreto del proyecto, nunca en Git.
CRON_SECRET=

# El scheduler residente solo se usa al ejecutar el servidor local. En Vercel debe permanecer
# desactivado porque /api/cron/sync reemplaza los temporizadores y procesos hijos.
ENABLE_DATA_SYNC=true
DATA_SYNC_RUN_ON_START=true
# Solo aplica cuando NO hay jornada en curso (o ya se confirmaron todos sus resultados):
# mientras una jornada está activa, el sistema sincroniza ~30 min después de cada partido
# sin resultado confirmado, más una sincronización extra de seguridad al final de la jornada.
DATA_SYNC_INTERVAL_HOURS=24
# Señal secundaria de demanda. Mantener false hasta alcanzar suficiente actividad real.
MARKET_MOMENTUM_ENABLED=false
# 0% con menos de 50 equipos, escala entre 50–100 y llega a fuerza normal desde 100.
MARKET_MOMENTUM_MIN_ACTIVE_MANAGERS=50
MARKET_MOMENTUM_FULL_STRENGTH_MANAGERS=100
MARKET_MOMENTUM_MIN_WINDOW_TRANSFERS=100
MARKET_MOMENTUM_WINDOW_HOURS=24
MARKET_MOMENTUM_WILDCARD_WEIGHT=0.25
MARKET_MOMENTUM_MAX_IMPACT_CENTS=10000000
# Una señal neta equivalente al 5% de los equipos activos alcanza la presión máxima.
MARKET_MOMENTUM_NET_RATE_FOR_MAX=0.05
# Seguridad: descarta equipos que generen más de 15 items en 24 h y cuentas menores de 24 h.
MARKET_MOMENTUM_MAX_ITEMS_PER_MANAGER=15
MARKET_MOMENTUM_MIN_MANAGER_AGE_HOURS=24
# Opcional: lista separada por comas de páginas oficiales de plantillas LPF.
# Si se omite, el worker usa las 12 páginas oficiales configuradas en el adapter.
LPF_ROSTER_URLS=
# Temporada usada para plantillas, fotos e historial de cambios de club.
TRANSFERMARKT_COMPETITION_URL=https://www.transfermarkt.es/liga-panamena-de-futbol-apertura/startseite/wettbewerb/PN1A/saison_id/2026
# Páginas de contraste. Los adapters guardan evidencia y solo crean entidades si existe un contrato verificable.
SOCCERWAY_LPF_URL=https://es.soccerway.com/panama/lpf/
SCORES365_LPF_URL=https://www.365scores.com/es/football/league/liga-panamena-5809
FOTMOB_LPF_URL=https://www.fotmob.com/leagues/9039/matches/lpf
