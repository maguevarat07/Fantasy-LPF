{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint api src server scripts --max-warnings=0",
    "typecheck:web": "tsc --noEmit",
    "typecheck:server": "tsc --project tsconfig.server.json",
    "typecheck": "npm run typecheck:web && npm run typecheck:server",
    "test": "vitest run",
    "test:final": "tsx scripts/final-product-exam.ts",
    "sync:lpf": "tsx scripts/sync-lpf-data.ts",
    "score:lpf": "tsx scripts/recalculate-points.ts",
    "db:import:postgres": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "db:validate:postgres": "tsx scripts/migrate-sqlite-to-postgres.ts --validate-only",
    "db:migrate:postgres": "tsx scripts/apply-postgres-migrations.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "postgres": "^3.4.9",
    "qs": "^6.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  }
}
