{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    },
    "api/cron/sync.ts": {
      "maxDuration": 300
    },
    "api/cron/advance.ts": {
      "maxDuration": 300
    },
    "api/cron/finalize.ts": {
      "maxDuration": 300
    },
    "api/cron/recover.ts": {
      "maxDuration": 300
    },
    "api/automation/worker.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/cron/slot(.*)",
      "destination": "/api/cron/sync"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
