{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    },
    "api/cron/sync.ts": {
      "maxDuration": 300
    },
    "api/cron/advance.ts": {
      "maxDuration": 300
    },
    "api/cron/finalize.ts": {
      "maxDuration": 300
    },
    "api/cron/recover.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/advance",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/finalize",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/recover",
      "schedule": "0 6 * * *"
    },
    { "path": "/api/cron/slot08", "schedule": "0 8 * * *" },
    { "path": "/api/cron/slot10", "schedule": "0 10 * * *" },
    { "path": "/api/cron/slot12", "schedule": "0 12 * * *" },
    { "path": "/api/cron/slot14", "schedule": "0 14 * * *" },
    { "path": "/api/cron/slot16", "schedule": "0 16 * * *" },
    { "path": "/api/cron/slot18", "schedule": "0 18 * * *" },
    { "path": "/api/cron/slot20", "schedule": "0 20 * * *" },
    { "path": "/api/cron/slot22", "schedule": "0 22 * * *" },
    { "path": "/api/cron/slot01", "schedule": "0 1 * * *" },
    { "path": "/api/cron/slot03", "schedule": "0 3 * * *" },
    { "path": "/api/cron/slot05", "schedule": "0 5 * * *" },
    { "path": "/api/cron/slot07", "schedule": "0 7 * * *" },
    { "path": "/api/cron/slot09", "schedule": "0 9 * * *" },
    { "path": "/api/cron/slot11", "schedule": "0 11 * * *" },
    { "path": "/api/cron/slot13", "schedule": "0 13 * * *" },
    { "path": "/api/cron/slot15", "schedule": "0 15 * * *" },
    { "path": "/api/cron/slot17", "schedule": "0 17 * * *" },
    { "path": "/api/cron/slot19", "schedule": "0 19 * * *" },
    { "path": "/api/cron/slot21", "schedule": "0 21 * * *" },
    { "path": "/api/cron/slot23", "schedule": "0 23 * * *" }
  ],
  "rewrites": [
    {
      "source": "/api/cron/slot(.*)",
      "destination": "/api/cron/sync"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
